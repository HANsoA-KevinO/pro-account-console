# Copy to .env for native server startup. No credentials belong in this file.
GATEWAY_PORT=8787
GATEWAY_DATA_DIR=./data
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_REQUIRE_ADMIN=true
GATEWAY_UPSTREAM_SESSION_TRANSPORT=http
GATEWAY_QUEUE_WAIT_MS=300000
# Set only when a TLS reverse proxy is ready; use an origin without a path.
# GATEWAY_PUBLIC_URL=https://gateway.example.com
# Optional: absolute path to an installed Codex CLI for quota synchronization.
# GATEWAY_CODEX_BIN=/usr/local/bin/codex
