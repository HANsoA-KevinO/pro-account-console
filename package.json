{
  "name": "pro-account-console",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:lan": "node server.mjs --lan",
    "start:server": "node --env-file=.env server.mjs --server",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:build": "node scripts/release-check.mjs --build",
    "cloudflare:login": "wrangler login --use-keyring",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:prepare": "node scripts/cloudflare.mjs prepare",
    "cloudflare:check": "node scripts/cloudflare.mjs check",
    "cloudflare:deploy": "node scripts/cloudflare.mjs deploy",
    "cloudflare:authorize": "node scripts/cloudflare.mjs authorize"
  },
  "files": [
    "server.mjs",
    "lib/",
    "public/",
    "vendor/modeltrace/",
    "deploy/",
    "Dockerfile",
    "cloudflare.Dockerfile",
    "wrangler.jsonc",
    "compose.yaml",
    ".env.example",
    "scripts/",
    "test/",
    ".github/",
    "README.md",
    "package-lock.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "dependencies": {
    "jose": "^6.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
